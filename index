import React, { useState, useEffect, useRef } from 'react';
import { initializeApp } from 'firebase/app';
import { getAuth, signInWithCustomToken, signInAnonymously, onAuthStateChanged } from 'firebase/auth';
import { 
  getFirestore, collection, doc, setDoc, deleteDoc, onSnapshot, serverTimestamp 
} from 'firebase/firestore';
import { 
  CheckCircle2, BookOpen, MessageCircle, Plus, Trash2, Send, 
  Calendar, Folder, GraduationCap, ArrowUpDown, X, Sparkles,
  ChevronRight, CircleDashed, CheckCircle, Clock
} from 'lucide-react';

const appId = typeof __app_id !== 'undefined' ? __app_id : 'study-flow-premium';
const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : {};
const initialAuthToken = typeof __initial_auth_token !== 'undefined' ? __initial_auth_token : null;

let app, db, auth;
try {
  app = initializeApp(firebaseConfig);
  db = getFirestore(app);
  auth = getAuth(app);
} catch (e) {
  console.error("Firebase init error", e);
}

const HomeworkTracker = ({ userId }) => {
  const [tasks, setTasks] = useState([]);
  const [module, setModule] = useState('');
  const [taskName, setTaskName] = useState('');
  const [dueDate, setDueDate] = useState('');
  const [showAddForm, setShowAddForm] = useState(false);
  
  const [filter, setFilter] = useState('all');
  const [sortBy, setSortBy] = useState('date');

  useEffect(() => {
    if (!userId || !db) return;
    const tasksRef = collection(db, 'artifacts', appId, 'users', userId, 'homework');
    const unsubscribe = onSnapshot(tasksRef, (snapshot) => {
      const loadedTasks = [];
      snapshot.forEach((doc) => {
        const data = doc.data();
        loadedTasks.push({ id: doc.id, ...data, status: data.status || (data.completed ? 'done' : 'open') });
      });
      setTasks(loadedTasks);
    });
    return () => unsubscribe();
  }, [userId]);

  const addTask = async (e) => {
    e.preventDefault();
    if (!module || !taskName || !dueDate || !userId) return;

    const newTask = { module, taskName, dueDate, status: 'open', createdAt: serverTimestamp() };
    const docRef = doc(db, 'artifacts', appId, 'users', userId, 'homework', crypto.randomUUID());
    await setDoc(docRef, newTask);
    
    setModule(''); setTaskName(''); setDueDate(''); setShowAddForm(false);
  };

  const cycleStatus = async (task, e) => {
    e.stopPropagation(); // Prevent card click if we click a specific button
    const statusOrder = ['open', 'in-progress', 'done'];
    const nextStatus = statusOrder[(statusOrder.indexOf(task.status) + 1) % statusOrder.length];
    await setDoc(doc(db, 'artifacts', appId, 'users', userId, 'homework', task.id), { ...task, status: nextStatus });
  };

  const deleteTask = async (taskId, e) => {
    e.stopPropagation();
    await deleteDoc(doc(db, 'artifacts', appId, 'users', userId, 'homework', taskId));
  };

  const getStatusConfig = (status) => {
    switch(status) {
      case 'open': return { bg: 'bg-zinc-100 dark:bg-zinc-800', text: 'text-zinc-600 dark:text-zinc-400', label: 'Offen', icon: <CircleDashed size={14}/> };
      case 'in-progress': return { bg: 'bg-indigo-100 dark:bg-indigo-500/20', text: 'text-indigo-600 dark:text-indigo-400', label: 'In Bearbeitung', icon: <Clock size={14}/> };
      case 'done': return { bg: 'bg-emerald-100 dark:bg-emerald-500/20', text: 'text-emerald-600 dark:text-emerald-400', label: 'Erledigt', done: true, icon: <CheckCircle size={14}/> };
      default: return { bg: 'bg-zinc-100 dark:bg-zinc-800', text: 'text-zinc-600 dark:text-zinc-400', label: 'Unbekannt', icon: <CircleDashed size={14}/> };
    }
  };

  const processedTasks = tasks
    .filter(t => filter === 'all' || t.status === filter)
    .sort((a, b) => sortBy === 'date' ? new Date(a.dueDate) - new Date(b.dueDate) : a.module.localeCompare(b.module));

  return (
    <div className="animate-in fade-in slide-in-from-bottom-4 duration-500 pb-8">
      {/* Header */}
      <div className="flex justify-between items-center mb-8 pt-2">
        <div>
          <p className="text-sm font-medium text-zinc-500 dark:text-zinc-400 tracking-wide uppercase mb-1">Deine Übersicht</p>
          <h1 className="text-3xl font-bold text-zinc-900 dark:text-white tracking-tight">Hausaufgaben</h1>
        </div>
        <button onClick={() => setShowAddForm(!showAddForm)} className="h-12 w-12 flex items-center justify-center bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 hover:scale-105 active:scale-95 rounded-full shadow-lg shadow-zinc-900/20 dark:shadow-white/10 transition-all">
          {showAddForm ? <X size={22} /> : <Plus size={22} />}
        </button>
      </div>

      {/* Add Form */}
      <div className={`overflow-hidden transition-all duration-300 ease-in-out ${showAddForm ? 'max-h-[500px] mb-8' : 'max-h-0'}`}>
        <form onSubmit={addTask} className="p-6 bg-white dark:bg-zinc-900 rounded-[2rem] shadow-xl shadow-zinc-200/40 dark:shadow-none border border-zinc-100 dark:border-zinc-800/80 relative overflow-hidden">
          <div className="absolute top-0 right-0 w-32 h-32 bg-indigo-500/10 dark:bg-indigo-500/5 blur-3xl rounded-full"></div>
          
          <h3 className="text-lg font-semibold text-zinc-800 dark:text-zinc-100 mb-5 relative z-10">Neue Aufgabe hinzufügen</h3>
          
          <div className="grid grid-cols-2 gap-4 mb-4 relative z-10">
            <div className="relative group">
              <Folder size={18} className="absolute left-4 top-1/2 -translate-y-1/2 text-zinc-400 group-focus-within:text-indigo-500 transition-colors" />
              <input type="text" placeholder="Modul (z.B. M319)" value={module} onChange={e => setModule(e.target.value)} required className="w-full pl-11 pr-4 py-3.5 bg-zinc-50 dark:bg-zinc-950/50 border border-zinc-200 dark:border-zinc-800 rounded-2xl outline-none focus:bg-white dark:focus:bg-zinc-900 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10 text-sm font-medium transition-all dark:text-white" />
            </div>
            <div className="relative group">
              <Calendar size={18} className="absolute left-4 top-1/2 -translate-y-1/2 text-zinc-400 group-focus-within:text-indigo-500 transition-colors" />
              <input type="date" value={dueDate} onChange={e => setDueDate(e.target.value)} required className="w-full pl-11 pr-4 py-3.5 bg-zinc-50 dark:bg-zinc-950/50 border border-zinc-200 dark:border-zinc-800 rounded-2xl outline-none focus:bg-white dark:focus:bg-zinc-900 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10 text-sm font-medium transition-all dark:text-white" />
            </div>
          </div>
          <input type="text" placeholder="Was genau muss erledigt werden?" value={taskName} onChange={e => setTaskName(e.target.value)} required className="w-full px-5 py-3.5 mb-5 bg-zinc-50 dark:bg-zinc-950/50 border border-zinc-200 dark:border-zinc-800 rounded-2xl outline-none focus:bg-white dark:focus:bg-zinc-900 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10 text-sm font-medium transition-all dark:text-white relative z-10" />
          
          <button type="submit" className="w-full py-4 bg-zinc-900 dark:bg-zinc-100 hover:bg-zinc-800 dark:hover:bg-white text-white dark:text-zinc-900 text-sm font-semibold rounded-2xl shadow-md transition-transform active:scale-[0.98] relative z-10">
            Speichern
          </button>
        </form>
      </div>

      {/* Filters & Sorting */}
      <div className="flex flex-col sm:flex-row justify-between items-center gap-4 mb-6">
        <div className="flex w-full sm:w-auto bg-zinc-100 dark:bg-zinc-900 p-1 rounded-2xl">
          {[{ id: 'all', label: 'Alle' }, { id: 'open', label: 'Offen' }, { id: 'in-progress', label: 'In Arbeit' }, { id: 'done', label: 'Fertig' }].map(f => (
            <button key={f.id} onClick={() => setFilter(f.id)} className={`flex-1 sm:flex-none px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition-all duration-300 ${filter === f.id ? 'bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white shadow-sm' : 'text-zinc-500 hover:text-zinc-700 dark:hover:text-zinc-300'}`}>
              {f.label}
            </button>
          ))}
        </div>
        
        <div className="relative w-full sm:w-auto">
          <ArrowUpDown size={14} className="absolute left-4 top-1/2 -translate-y-1/2 text-zinc-400" />
          <select value={sortBy} onChange={(e) => setSortBy(e.target.value)} className="w-full sm:w-auto pl-10 pr-10 py-2.5 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-700 dark:text-zinc-300 rounded-2xl text-xs font-semibold outline-none focus:ring-2 focus:ring-indigo-500 appearance-none cursor-pointer shadow-sm">
            <option value="date">Sortieren: Datum</option>
            <option value="module">Sortieren: Modul</option>
          </select>
        </div>
      </div>

      {/* Task List */}
      <div className="space-y-3">
        {processedTasks.length === 0 ? (
          <div className="text-center py-16 px-4 bg-white/50 dark:bg-zinc-900/30 rounded-[2rem] border border-dashed border-zinc-300 dark:border-zinc-700">
            <div className="w-16 h-16 bg-zinc-100 dark:bg-zinc-800 rounded-full flex items-center justify-center mx-auto mb-4">
              <Sparkles size={24} className="text-indigo-400" />
            </div>
            <h3 className="text-lg font-semibold text-zinc-800 dark:text-zinc-200 mb-1">Alles erledigt!</h3>
            <p className="text-zinc-500 dark:text-zinc-400 text-sm">Lehn dich zurück und genieß die freie Zeit.</p>
          </div>
        ) : (
          processedTasks.map(task => {
            const conf = getStatusConfig(task.status);
            return (
              <div key={task.id} onClick={(e) => cycleStatus(task, e)} className={`group bg-white dark:bg-zinc-900 p-5 rounded-3xl shadow-sm hover:shadow-md border border-zinc-100 dark:border-zinc-800/80 transition-all duration-300 cursor-pointer ${conf.done ? 'opacity-60 grayscale-[0.3]' : ''}`}>
                <div className="flex justify-between items-start gap-4">
                  
                  <div className="flex-1">
                    <div className="flex items-center gap-2 mb-2">
                      <span className="text-[10px] font-bold tracking-widest text-indigo-500 dark:text-indigo-400 uppercase bg-indigo-50 dark:bg-indigo-500/10 px-2.5 py-1 rounded-md">{task.module}</span>
                    </div>
                    <h3 className={`text-base font-semibold transition-colors mb-3 pr-4 leading-tight ${conf.done ? 'text-zinc-400 line-through' : 'text-zinc-800 dark:text-zinc-100'}`}>
                      {task.taskName}
                    </h3>
                    
                    <div className="flex items-center gap-3 mt-auto">
                      <div className="flex items-center gap-1.5 text-xs font-medium text-zinc-500 dark:text-zinc-400 bg-zinc-50 dark:bg-zinc-950/50 px-2.5 py-1 rounded-lg">
                        <Calendar size={12} />
                        {new Date(task.dueDate).toLocaleDateString('de-CH', { weekday: 'short', day: '2-digit', month: 'short' })}
                      </div>
                      <div className={`flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[11px] font-bold tracking-wide transition-colors ${conf.bg} ${conf.text}`}>
                        {conf.icon}
                        {conf.label}
                      </div>
                    </div>
                  </div>
                  
                  <button onClick={(e) => deleteTask(task.id, e)} className="p-2 text-zinc-300 hover:text-red-500 hover:bg-red-50 dark:hover:bg-red-500/10 rounded-full transition-all">
                    <Trash2 size={18} />
                  </button>

                </div>
              </div>
            );
          })
        )}
      </div>
    </div>
  );
};

const GradeBook = ({ userId }) => {
  const [grades, setGrades] = useState([]);
  const [module, setModule] = useState('');
  const [testName, setTestName] = useState('');
  const [grade, setGrade] = useState('');
  const [showAddForm, setShowAddForm] = useState(false);

  useEffect(() => {
    if (!userId || !db) return;
    const gradesRef = collection(db, 'artifacts', appId, 'users', userId, 'grades');
    const unsubscribe = onSnapshot(gradesRef, (snapshot) => {
      const loadedGrades = [];
      snapshot.forEach((doc) => loadedGrades.push({ id: doc.id, ...doc.data() }));
      loadedGrades.sort((a, b) => new Date(b.createdAt?.toDate() || 0) - new Date(a.createdAt?.toDate() || 0));
      setGrades(loadedGrades);
    });
    return () => unsubscribe();
  }, [userId]);

  const addGrade = async (e) => {
    e.preventDefault();
    const numGrade = parseFloat(grade.replace(',', '.'));
    if (!module || !testName || isNaN(numGrade) || numGrade < 1 || numGrade > 6 || !userId) return;

    const newGrade = { module, testName, grade: numGrade, createdAt: serverTimestamp() };
    await setDoc(doc(db, 'artifacts', appId, 'users', userId, 'grades', crypto.randomUUID()), newGrade);
    setTestName(''); setGrade(''); setShowAddForm(false);
  };

  const deleteGrade = async (gradeId) => {
    await deleteDoc(doc(db, 'artifacts', appId, 'users', userId, 'grades', gradeId));
  };

  const moduleData = grades.reduce((acc, curr) => {
    if (!acc[curr.module]) acc[curr.module] = [];
    acc[curr.module].push(curr);
    return acc;
  }, {});

  const modulesAverages = Object.entries(moduleData).map(([modName, modGrades]) => ({
    name: modName, 
    average: modGrades.reduce((sum, g) => sum + g.grade, 0) / modGrades.length, 
    gradesData: modGrades 
  }));

  const overallAverage = modulesAverages.length > 0 ? modulesAverages.reduce((sum, m) => sum + m.average, 0) / modulesAverages.length : null;

  return (
    <div className="animate-in fade-in slide-in-from-bottom-4 duration-500 pb-8">
      
      {/* Header */}
      <div className="flex justify-between items-center mb-6 pt-2">
        <div>
          <p className="text-sm font-medium text-zinc-500 dark:text-zinc-400 tracking-wide uppercase mb-1">Deine Leistung</p>
          <h1 className="text-3xl font-bold text-zinc-900 dark:text-white tracking-tight">Notenbuch</h1>
        </div>
      </div>

      {/* Hero Section: Overall Average */}
      <div className="mb-8 relative overflow-hidden bg-gradient-to-br from-zinc-900 to-zinc-800 dark:from-zinc-100 dark:to-zinc-300 rounded-[2.5rem] p-8 text-white dark:text-zinc-900 shadow-xl shadow-zinc-900/20 dark:shadow-white/10">
        <div className="absolute -right-8 -top-8 opacity-5 text-white dark:text-black">
          <GraduationCap size={200} strokeWidth={1} />
        </div>
        <div className="relative z-10 flex flex-col items-center text-center">
          <h2 className="text-zinc-300 dark:text-zinc-600 font-semibold tracking-widest text-xs uppercase mb-3">Gesamtdurchschnitt</h2>
          <div className="flex items-baseline justify-center gap-2">
            <span className="text-7xl font-black tracking-tighter">{overallAverage ? overallAverage.toFixed(2) : '-.--'}</span>
          </div>
          {overallAverage && (
             <div className="mt-4 px-4 py-1.5 rounded-full bg-white/10 dark:bg-black/5 backdrop-blur-md border border-white/20 dark:border-black/10 text-sm font-medium">
               {overallAverage >= 4.0 ? 'Weiter so! 🎉' : 'Da geht noch was 💪'}
             </div>
          )}
        </div>
      </div>

      {/* Add Grade Button & Form */}
      <div className="flex justify-between items-center mb-6">
        <h2 className="text-xl font-bold text-zinc-800 dark:text-zinc-100">Nach Modulen</h2>
        <button onClick={() => setShowAddForm(!showAddForm)} className="flex items-center gap-1.5 px-4 py-2 bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 rounded-full shadow-sm text-sm font-semibold transition-transform active:scale-95">
          {showAddForm ? <X size={16}/> : <Plus size={16}/>} Note
        </button>
      </div>

      <div className={`overflow-hidden transition-all duration-300 ease-in-out ${showAddForm ? 'max-h-[500px] mb-8' : 'max-h-0'}`}>
        <form onSubmit={addGrade} className="p-6 bg-white dark:bg-zinc-900 rounded-[2rem] shadow-xl shadow-zinc-200/40 dark:shadow-none border border-zinc-100 dark:border-zinc-800/80">
          <div className="grid grid-cols-1 sm:grid-cols-12 gap-4 mb-5">
            <div className="sm:col-span-5 relative group">
               <input type="text" placeholder="Modul (z.B. M162)" value={module} onChange={e => setModule(e.target.value)} required className="w-full px-5 py-3.5 bg-zinc-50 dark:bg-zinc-950/50 border border-zinc-200 dark:border-zinc-800 rounded-2xl outline-none focus:bg-white dark:focus:bg-zinc-900 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10 text-sm font-medium transition-all dark:text-white" />
            </div>
            <div className="sm:col-span-4 relative group">
              <input type="text" placeholder="Prüfungstitel" value={testName} onChange={e => setTestName(e.target.value)} required className="w-full px-5 py-3.5 bg-zinc-50 dark:bg-zinc-950/50 border border-zinc-200 dark:border-zinc-800 rounded-2xl outline-none focus:bg-white dark:focus:bg-zinc-900 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10 text-sm font-medium transition-all dark:text-white" />
            </div>
            <div className="sm:col-span-3 relative group">
              <input type="number" step="0.1" min="1" max="6" placeholder="Note (1-6)" value={grade} onChange={e => setGrade(e.target.value)} required className="w-full px-5 py-3.5 font-bold text-center bg-zinc-50 dark:bg-zinc-950/50 border border-zinc-200 dark:border-zinc-800 rounded-2xl outline-none focus:bg-white dark:focus:bg-zinc-900 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10 text-lg transition-all dark:text-white" />
            </div>
          </div>
          <button type="submit" className="w-full py-4 bg-zinc-900 dark:bg-zinc-100 hover:bg-zinc-800 dark:hover:bg-white text-white dark:text-zinc-900 text-sm font-semibold rounded-2xl shadow-md transition-transform active:scale-[0.98]">
            Eintragen
          </button>
        </form>
      </div>

      {/* Module Cards */}
      <div className="grid grid-cols-1 md:grid-cols-2 gap-5">
        {modulesAverages.map(mod => {
          const isPassing = mod.average >= 4.0;
          return (
            <div key={mod.name} className="bg-white dark:bg-zinc-900 p-6 rounded-[2rem] shadow-sm border border-zinc-100 dark:border-zinc-800/80 hover:shadow-md transition-shadow">
              
              <div className="flex justify-between items-center mb-5">
                <h3 className="font-bold text-xl text-zinc-900 dark:text-zinc-100">{mod.name}</h3>
                <div className="flex flex-col items-end">
                  <span className="text-[10px] text-zinc-400 uppercase tracking-widest font-bold mb-0.5">Schnitt</span>
                  <div className={`px-3 py-1 rounded-xl font-black text-lg ${isPassing ? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-500/20 dark:text-emerald-400' : 'bg-red-100 text-red-700 dark:bg-red-500/20 dark:text-red-400'}`}>
                    {mod.average.toFixed(2)}
                  </div>
                </div>
              </div>

              <div className="space-y-3 pt-4 border-t border-zinc-100 dark:border-zinc-800/80">
                {mod.gradesData.map(g => {
                   const isGradePassing = g.grade >= 4.0;
                   return (
                  <div key={g.id} className="flex justify-between items-center group p-2 hover:bg-zinc-50 dark:hover:bg-zinc-800/50 rounded-xl transition-colors -mx-2">
                    <span className="text-zinc-700 dark:text-zinc-300 text-sm font-medium">{g.testName}</span>
                    <div className="flex items-center gap-3">
                      <span className={`font-bold text-base ${isGradePassing ? 'text-emerald-600 dark:text-emerald-400' : 'text-red-600 dark:text-red-400'}`}>
                        {g.grade.toFixed(1)}
                      </span>
                      <button onClick={() => deleteGrade(g.id)} className="text-zinc-300 hover:text-red-500 p-1.5 bg-white dark:bg-zinc-900 shadow-sm border border-zinc-200 dark:border-zinc-700 rounded-full opacity-0 group-hover:opacity-100 transition-all active:scale-90">
                        <Trash2 size={14} />
                      </button>
                    </div>
                  </div>
                )})}
              </div>
            </div>
          )
        })}
      </div>
      {modulesAverages.length === 0 && (
        <div className="text-center py-16 text-zinc-400 dark:text-zinc-600">
          <BookOpen size={48} className="mx-auto mb-4 opacity-20" />
          <p className="font-medium">Noch keine Noten eingetragen.</p>
        </div>
      )}
    </div>
  );
};

const AIChat = () => {
  const [messages, setMessages] = useState([{ role: 'model', text: 'Hey! 👋 Ich bin dein KI-Tutor. Hast du Fragen zu Modulen oder Hausaufgaben?' }]);
  const [input, setInput] = useState('');
  const [loading, setLoading] = useState(false);
  const messagesEndRef = useRef(null);

  useEffect(() => {
    messagesEndRef.current?.scrollIntoView({ behavior: "smooth" });
  }, [messages, loading]);

  const sendMessage = async (e) => {
    e.preventDefault();
    if (!input.trim()) return;
    
    const userText = input.trim();
    setInput('');
    const newHistory = [...messages, { role: 'user', text: userText }];
    setMessages(newHistory);
    setLoading(true);

    try {
      const payload = {
        contents: newHistory.map(m => ({ role: m.role, parts: [{ text: m.text }] })),
        systemInstruction: { parts: [{ text: "Du bist ein hilfsbereiter, präziser KI-Tutor für einen Schüler/Studenten aus der Schweiz. Antworte in klarem, modernem Deutsch." }] }
      };
      // API Key intentionally left blank
      const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const result = await response.json();
      if (result.candidates?.[0]?.content?.parts?.[0]?.text) {
        setMessages([...newHistory, { role: 'model', text: result.candidates[0].content.parts[0].text }]);
      }
    } catch (error) {
      setMessages([...newHistory, { role: 'model', text: "Entschuldigung, es gab einen Verbindungsfehler. Versuche es später noch einmal." }]);
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="flex flex-col h-[calc(100vh-6rem)] -mt-4 animate-in fade-in duration-500">
      
      {/* Header Sticky */}
      <div className="pt-6 pb-4 px-2 sticky top-0 z-20 bg-zinc-50/90 dark:bg-zinc-950/90 backdrop-blur-md">
        <h1 className="text-2xl font-bold flex items-center gap-2 text-zinc-900 dark:text-white">
          <div className="w-10 h-10 rounded-full bg-gradient-to-tr from-indigo-500 to-fuchsia-500 flex items-center justify-center shadow-lg shadow-indigo-500/30 text-white">
            <Sparkles size={20} />
          </div>
          KI Tutor
        </h1>
      </div>
      
      {/* Chat Messages */}
      <div className="flex-1 overflow-y-auto px-2 space-y-6 pb-4 no-scrollbar">
        {messages.map((msg, idx) => (
          <div key={idx} className={`flex ${msg.role === 'user' ? 'justify-end' : 'justify-start'}`}>
            <div className={`max-w-[85%] px-5 py-4 rounded-[2rem] shadow-sm text-[15px] leading-relaxed ${
              msg.role === 'user' 
                ? 'bg-zinc-900 dark:bg-zinc-100 text-white dark:text-zinc-900 rounded-br-md font-medium' 
                : 'bg-white dark:bg-zinc-900 text-zinc-800 dark:text-zinc-200 rounded-bl-md border border-zinc-100 dark:border-zinc-800/80'
            }`}>
              <p className="whitespace-pre-wrap">{msg.text}</p>
            </div>
          </div>
        ))}
        {loading && (
          <div className="flex justify-start">
             <div className="bg-white dark:bg-zinc-900 rounded-[2rem] rounded-bl-md px-5 py-5 shadow-sm border border-zinc-100 dark:border-zinc-800/80 flex gap-2 items-center">
                <span className="w-2 h-2 bg-zinc-400 rounded-full animate-bounce"></span>
                <span className="w-2 h-2 bg-zinc-400 rounded-full animate-bounce" style={{animationDelay: '0.15s'}}></span>
                <span className="w-2 h-2 bg-zinc-400 rounded-full animate-bounce" style={{animationDelay: '0.3s'}}></span>
             </div>
          </div>
        )}
        <div ref={messagesEndRef} />
      </div>

      {/* Input Area */}
      <div className="sticky bottom-0 bg-gradient-to-t from-zinc-50 via-zinc-50 to-transparent dark:from-zinc-950 dark:via-zinc-950 pt-4 pb-2 z-20">
        <form onSubmit={sendMessage} className="relative flex items-center shadow-xl shadow-zinc-200/50 dark:shadow-black/50 rounded-full bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800">
          <input 
            type="text" 
            value={input} 
            onChange={(e) => setInput(e.target.value)} 
            placeholder="Schreibe eine Nachricht..." 
            className="w-full pl-6 pr-14 py-4.5 bg-transparent rounded-full outline-none text-[15px] font-medium dark:text-white placeholder-zinc-400"
            disabled={loading}
          />
          <button type="submit" disabled={loading || !input.trim()} className="absolute right-2.5 p-3 bg-zinc-900 dark:bg-zinc-100 hover:bg-zinc-800 dark:hover:bg-white disabled:opacity-50 text-white dark:text-zinc-900 rounded-full transition-transform active:scale-90 flex items-center justify-center">
            <Send size={18} className="ml-0.5" />
          </button>
        </form>
      </div>
    </div>
  );
};

export default function App() {
  const [activeTab, setActiveTab] = useState('homework');
  const [user, setUser] = useState(null);
  const [authLoading, setAuthLoading] = useState(true);

  useEffect(() => {
    if (!auth) { setAuthLoading(false); return; }
    const initAuth = async () => {
      try {
        if (initialAuthToken) await signInWithCustomToken(auth, initialAuthToken);
        else await signInAnonymously(auth);
      } catch (error) { console.error("Auth error:", error); }
    };
    const unsubscribe = onAuthStateChanged(auth, (currentUser) => {
      setUser(currentUser);
      setAuthLoading(false);
    });
    initAuth();
    return () => unsubscribe();
  }, []);

  if (authLoading) {
    return (
      <div className="flex h-screen items-center justify-center bg-zinc-50 dark:bg-zinc-950">
        <div className="flex flex-col items-center gap-4">
          <div className="w-12 h-12 border-4 border-zinc-200 dark:border-zinc-800 border-t-zinc-900 dark:border-t-white rounded-full animate-spin"></div>
          <p className="text-zinc-500 dark:text-zinc-400 font-medium tracking-wide">Lade StudyFlow...</p>
        </div>
      </div>
    );
  }

  const renderContent = () => {
    switch (activeTab) {
      case 'homework': return <HomeworkTracker userId={user?.uid} />;
      case 'grades': return <GradeBook userId={user?.uid} />;
      case 'chat': return <AIChat />;
      default: return <HomeworkTracker userId={user?.uid} />;
    }
  };

  return (
    <div className="min-h-screen bg-zinc-50 dark:bg-zinc-950 text-zinc-900 dark:text-zinc-100 transition-colors duration-500 font-sans selection:bg-indigo-200 dark:selection:bg-indigo-900/50">
      
      {/* Background Decor */}
      <div className="fixed top-0 left-0 right-0 h-96 bg-gradient-to-b from-zinc-100 dark:from-zinc-900 to-transparent pointer-events-none -z-10"></div>
      
      <main className="max-w-2xl mx-auto px-4 sm:px-6 pt-8 pb-32 h-full">
        {renderContent()}
      </main>

      {/* Modern Floating Bottom Navigation */}
      <div className="fixed bottom-6 left-0 right-0 px-4 pointer-events-none z-50 flex justify-center">
        <nav className="pointer-events-auto w-full max-w-sm bg-white/80 dark:bg-zinc-900/80 backdrop-blur-2xl border border-white/40 dark:border-zinc-800/60 shadow-[0_8px_30px_rgb(0,0,0,0.08)] dark:shadow-[0_8px_30px_rgb(0,0,0,0.4)] rounded-full px-2 py-2 flex justify-around items-center">
          
          <button onClick={() => setActiveTab('homework')} className={`relative flex flex-col items-center justify-center w-20 h-16 rounded-[2rem] transition-all duration-500 ${activeTab === 'homework' ? 'text-zinc-900 dark:text-white' : 'text-zinc-400 hover:text-zinc-600 dark:hover:text-zinc-300'}`}>
            {activeTab === 'homework' && <div className="absolute inset-0 bg-zinc-100 dark:bg-zinc-800 rounded-[2rem] transition-all duration-500 shadow-inner"></div>}
            <CheckCircle2 size={24} className={`relative z-10 mb-1 transition-transform duration-500 ${activeTab === 'homework' ? 'scale-110' : ''}`} />
            <span className={`text-[10px] font-bold tracking-wide relative z-10 transition-opacity duration-500 ${activeTab === 'homework' ? 'opacity-100' : 'opacity-0'}`}>Aufgaben</span>
          </button>
          
          <button onClick={() => setActiveTab('grades')} className={`relative flex flex-col items-center justify-center w-20 h-16 rounded-[2rem] transition-all duration-500 ${activeTab === 'grades' ? 'text-zinc-900 dark:text-white' : 'text-zinc-400 hover:text-zinc-600 dark:hover:text-zinc-300'}`}>
            {activeTab === 'grades' && <div className="absolute inset-0 bg-zinc-100 dark:bg-zinc-800 rounded-[2rem] transition-all duration-500 shadow-inner"></div>}
            <BookOpen size={24} className={`relative z-10 mb-1 transition-transform duration-500 ${activeTab === 'grades' ? 'scale-110' : ''}`} />
            <span className={`text-[10px] font-bold tracking-wide relative z-10 transition-opacity duration-500 ${activeTab === 'grades' ? 'opacity-100' : 'opacity-0'}`}>Noten</span>
          </button>
          
          <button onClick={() => setActiveTab('chat')} className={`relative flex flex-col items-center justify-center w-20 h-16 rounded-[2rem] transition-all duration-500 ${activeTab === 'chat' ? 'text-zinc-900 dark:text-white' : 'text-zinc-400 hover:text-zinc-600 dark:hover:text-zinc-300'}`}>
            {activeTab === 'chat' && <div className="absolute inset-0 bg-zinc-100 dark:bg-zinc-800 rounded-[2rem] transition-all duration-500 shadow-inner"></div>}
            <MessageCircle size={24} className={`relative z-10 mb-1 transition-transform duration-500 ${activeTab === 'chat' ? 'scale-110' : ''}`} />
            <span className={`text-[10px] font-bold tracking-wide relative z-10 transition-opacity duration-500 ${activeTab === 'chat' ? 'opacity-100' : 'opacity-0'}`}>Tutor</span>
          </button>
          
        </nav>
      </div>
    </div>
  );
}
